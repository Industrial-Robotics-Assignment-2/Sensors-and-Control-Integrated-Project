<?xml version="1.0"?>
<sdf version="1.6">
  <model name="bedroom">
    <static>true</static>  <!-- remove if it should move/fall -->
    <link name="link">
      <self_collide>false</self_collide>
      <gravity>1</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://bedroom/meshes/bedroom.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.72 0.70 0.65 1</ambient>
          <diffuse>0.92 0.90 0.85 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://bedroom/meshes/bedroom.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>