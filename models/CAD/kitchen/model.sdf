<?xml version="1.0"?>
<sdf version="1.6">
  <model name="kitchen">
    <static>true</static>  <!-- remove if it should move/fall -->
    <link name="link">
      <self_collide>false</self_collide>
      <gravity>1</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://kitchen/meshes/kitchen.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.20 0.07 0.02 1</ambient>
          <diffuse>0.65 0.32 0.12 1</diffuse>
          <specular>0.10 0.05 0.02 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://kitchen/meshes/kitchen.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>